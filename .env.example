# ChronicleAI Environment Configuration Template

# Server Configuration
ENVIRONMENT=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration
DATABASE_URL=sqlite:///./data/chronicle.db

# Storage
DATA_DIR=./data
UPLOAD_DIR=./data/files

# Logging
LOG_LEVEL=INFO

# AI Provider (Gemini API - for future Phase 2+)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
