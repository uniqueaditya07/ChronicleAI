# ChronicleAI Environment Configuration
# Reference template: set these variables in the backend process environment.
# The application does not automatically load .env files.

# Optional Gemini API Key for case analysis and case-specific AI chat.
# Without a key, AI endpoints return a controlled error; local evidence tools remain available.
GEMINI_API_KEY=

# Gemini Model Identifier (Default: gemini-3.5-flash-lite)
# Optional override; select a model that supports generateContent for your API project.
GEMINI_MODEL=gemini-3.5-flash-lite

# Evidence Context Budget (character limit before analysis fails safely)
GEMINI_MAX_CONTEXT_CHARS=100000
