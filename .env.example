# ChronicleAI Environment Configuration
# Reference template: set these variables in the backend process environment.
# The application does not automatically load .env files.

# Optional SQLAlchemy database URL. Leave unset for the local SQLite default.
# For PostgreSQL use postgresql://...; the backend selects psycopg 3, requires
# TLS by default, and limits each process to five concurrent connections.
# DATABASE_URL=

# Optional Gemini API Key for case analysis and case-specific AI chat.
# Without a key, AI endpoints return a controlled error; local evidence tools remain available.
GEMINI_API_KEY=

# Gemini Model Identifier (Default: gemini-3.5-flash-lite)
# Optional override; select a model that supports generateContent for your API project.
GEMINI_MODEL=gemini-3.5-flash-lite

# Evidence Context Budget (character limit before analysis fails safely)
GEMINI_MAX_CONTEXT_CHARS=100000

# Evidence storage defaults to the existing local filesystem vault.
CHRONICLE_STORAGE_BACKEND=local
# CHRONICLE_STORAGE_DIR=/absolute/path/to/evidence

# Set these only when CHRONICLE_STORAGE_BACKEND=supabase.
# Configure the service role key in the backend's secret environment only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-service-role-key
SUPABASE_STORAGE_BUCKET=chronicleai-evidence
